# ---------------------------------------------------------------------------
# KiCad (https://www.kicad.org/) - based on github/gitignore KiCad.gitignore
# ---------------------------------------------------------------------------

# Backups, autosave and lock files
*-backups/
_autosave-*
\#auto_saved_files\#
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*-save.pro
*-save.kicad_pcb
*.tmp
*.lck
*~

# Per-user local project settings and caches (regenerated by KiCad)
*.kicad_prl
fp-info-cache

# Netlists and autorouter intermediates (regenerated from the design)
*.net
*.dsn
*.ses

# ---------------------------------------------------------------------------
# Third-party reference documents
# Downloaded by doc/fetch_docs.sh from the URLs in doc/sources.tsv.
# They are not redistributed; doc/vendor.sha256 records what was fetched.
# ---------------------------------------------------------------------------
doc/vendor/
*.part

# ---------------------------------------------------------------------------
# Editors / OS / tools
# ---------------------------------------------------------------------------
.history/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
__pycache__/
*.pyc
